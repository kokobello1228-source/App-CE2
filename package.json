    "zod": "^4.6.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts",
    "check": "npm run typecheck && npm run validate && npm test",
    "build:web": "node scripts/build-web.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx",
      "<rootDir>/*.test.ts"
    ]
